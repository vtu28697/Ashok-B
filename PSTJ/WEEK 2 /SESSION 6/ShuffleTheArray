#PROGRAM
class Solution {
    public int[] shuffle(int[] nums, int n) {
        
        int[] result = new int[2 * n];
        
        int index = 0;

        for (int i = 0; i < n; i++) {
            result[index++] = nums[i];       // xi
            result[index++] = nums[i + n];   // yi
        }

        return result;
    }
}
#INPUT
nums =
[2,5,1,3,4,7]
n =3
#OUTPUT
[2,3,5,4,1,7]
