#PROGRAM
class Solution {
    public int largestAltitude(int[] gain) {
        int currentAltitude = 0;
        int highestAltitude = 0;
        
        for (int g : gain) {
            currentAltitude += g;
            if (currentAltitude > highestAltitude) {
                highestAltitude = currentAltitude;
            }
        }
        
        return highestAltitude;
    }
}
#INPUT
gain =
[-5,1,5,0,-7]
#OUTPUT
1 
