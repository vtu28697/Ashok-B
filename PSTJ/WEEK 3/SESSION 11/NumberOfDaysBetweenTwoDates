#PROGRAM
class Solution {
    public int daysBetweenDates(String date1, String date2) {

        String[] a = date1.split("-");
        String[] b = date2.split("-");

        int y1 = Integer.parseInt(a[0]);
        int m1 = Integer.parseInt(a[1]);
        int d1 = Integer.parseInt(a[2]);

        int y2 = Integer.parseInt(b[0]);
        int m2 = Integer.parseInt(b[1]);
        int d2 = Integer.parseInt(b[2]);

        int days1 = getDays(y1, m1, d1);
        int days2 = getDays(y2, m2, d2);

        return Math.abs(days1 - days2);
    }

    public int getDays(int year, int month, int day) {

        int[] days = {
            0, 31, 28, 31, 30, 31,
            30, 31, 31, 30, 31, 30, 31
        };

        int total = 0;

        // Add days of previous years
        for (int i = 1971; i < year; i++) {
            if (isLeap(i)) {
                total += 366;
            } else {
                total += 365;
            }
        }

        // Add days of previous months
        for (int i = 1; i < month; i++) {
            total += days[i];

            if (i == 2 && isLeap(year)) {
                total++;
            }
        }

        total += day;

        return total;
    }

    public boolean isLeap(int year) {
        if (year % 400 == 0) {
            return true;
        }

        if (year % 100 == 0) {
            return false;
        }

        return year % 4 == 0;
    }
}
